{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent-stop-hook.ts\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
